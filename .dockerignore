__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Data files (we mount them as volumes instead)
data/raw/*.parquet
data/cleaned/
data/warehouse/
data/quality_reports/
*.parquet
*.csv
*.json
*.db

# Logs
*.log
logs/

# Documentation
docs/*.pdf
docs/*.docx
README.md
LICENSE

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Tests
.pytest_cache/
.coverage
htmlcov/

# Other
.env
*.bak
*.tmp
