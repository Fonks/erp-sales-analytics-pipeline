erDiagram
    fact_sales ||--o{ dim_customers : "customer_key"
    fact_sales ||--o{ dim_products : "product_key"
    fact_sales ||--o{ dim_channels : "channel_key"
    fact_sales ||--o{ dim_date : "order_date_key"
    
    fact_returns ||--o{ dim_customers : "customer_key"
    fact_returns ||--o{ dim_products : "product_key"
    fact_returns ||--o{ dim_channels : "channel_key"
    fact_returns ||--o{ dim_date : "return_date_key"
    fact_returns ||--o{ dim_date : "order_date_key"

    fact_sales {
        BIGINT sale_id PK
        STRING order_id
        STRING order_item_id
        BIGINT customer_key FK
        BIGINT product_key FK
        BIGINT channel_key FK
        INT order_date_key FK
        INT quantity
        DECIMAL unit_price
        DECIMAL total_amount
        TIMESTAMP created_at
    }

    fact_returns {
        BIGINT return_id PK
        STRING order_id
        STRING order_item_id
        BIGINT customer_key FK
        BIGINT product_key FK
        BIGINT channel_key FK
        INT return_date_key FK
        INT order_date_key FK
        INT quantity_returned
        DECIMAL return_amount
        STRING return_reason
        TIMESTAMP created_at
    }

    dim_customers {
        BIGINT customer_key PK
        STRING customer_id UK
        STRING customer_name
        STRING customer_segment
        DATE registration_date
        STRING country
        STRING city
        BOOLEAN is_active
        TIMESTAMP valid_from
        TIMESTAMP valid_to
        BOOLEAN is_current
        TIMESTAMP created_at
    }

    dim_products {
        BIGINT product_key PK
        STRING product_id UK
        STRING product_name
        STRING category
        STRING subcategory
        STRING brand
        STRING color
        STRING size
        DECIMAL price
        BOOLEAN is_active
        TIMESTAMP created_at
    }

    dim_channels {
        BIGINT channel_key PK
        STRING channel_id UK
        STRING channel_name
        STRING channel_type
        BOOLEAN is_active
        TIMESTAMP created_at
    }

    dim_date {
        INT date_key PK
        DATE full_date
        INT day_of_week
        STRING day_name
        INT day_of_month
        INT day_of_year
        INT week_of_year
        INT month
        STRING month_name
        INT quarter
        INT year
        BOOLEAN is_weekend
        BOOLEAN is_holiday
        INT fiscal_year
        INT fiscal_quarter
    }
